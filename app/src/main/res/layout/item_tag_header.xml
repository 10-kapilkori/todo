<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/min_touch_target"
    android:paddingHorizontal="@dimen/header_padding_horizontal"
    android:paddingVertical="@dimen/header_padding_vertical">

    <!-- Tag Icon -->
    <ImageView
        android:id="@+id/tagIcon"
        android:layout_width="@dimen/header_icon_size"
        android:layout_height="@dimen/header_icon_size"
        android:contentDescription="Tag icon"
        android:src="@drawable/ic_label"
        app:layout_constraintBottom_toBottomOf="@+id/tagName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tagName"
        app:tint="@android:color/transparent" />

    <!-- Tag Name -->
    <TextView
        android:id="@+id/tagName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@+id/tagCount"
        app:layout_constraintStart_toEndOf="@+id/tagIcon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Work" />

    <!-- Tag Count Badge -->
    <TextView
        android:id="@+id/tagCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/count_pill_background"
        android:paddingHorizontal="@dimen/header_count_pill_padding_horizontal"
        android:paddingVertical="@dimen/header_count_pill_padding_vertical"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@+id/chevronIcon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="3" />

    <!-- Chevron Icon -->
    <ImageView
        android:id="@+id/chevronIcon"
        android:layout_width="@dimen/header_chevron_size"
        android:layout_height="@dimen/header_chevron_size"
        android:contentDescription="Expand or collapse section"
        android:src="@drawable/ic_expand_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurfaceVariant" />

    <!-- Inline Empty Text (shown when expanded with 0 tasks) -->
    <TextView
        android:id="@+id/emptyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/no_tasks_in_this_tag"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tagName"
        app:layout_constraintTop_toBottomOf="@+id/tagName"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
